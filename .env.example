# =========================================================================
# AI-Powered Alcohol Label Verification App - Environment Configuration Example
# =========================================================================
# Copy this file to '.env.local' inside the 'label-verification/' directory
# or the workspace root to use environment variables for authentication.
# 
# The application automatically detects and routes verification requests
# based on which keys are configured.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Google Gemini API Configuration (Default)
# -------------------------------------------------------------------------
# Gemini 1.5 Flash is used for low-latency visual OCR extraction (< 2s latency).
# Prefix: Key typically starts with 'AIzaSy...'
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------------
# 2. Anthropic Claude API Configuration (Optional)
# -------------------------------------------------------------------------
# Claude 3.5 Sonnet is used if a Claude key is provided (or if a key starting
# with 'sk-ant-' is entered in the UI Settings Panel).
# Prefix: Key typically starts with 'sk-ant-...'
# Obtain from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Note: You can also use ANTHROPIC_API_KEY as an alias for CLAUDE_API_KEY:
# ANTHROPIC_API_KEY=your_claude_api_key_here
